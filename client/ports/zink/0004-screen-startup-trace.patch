+/* Bounded fixed startup labels; retain errno and all original control flow. */
+static void
+ps5_screen_stage(const char *label)
+{
+   static unsigned events;
+   unsigned n = __atomic_load_n(&events, __ATOMIC_RELAXED);
+   while (n < 64 && !__atomic_compare_exchange_n(&events, &n, n + 1, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+   if (n < 64) {
+      int saved = errno;
+      fprintf(stderr, "PS5_ZINK screen stage %s\n", label);
+      errno = saved;
+   }
+}
